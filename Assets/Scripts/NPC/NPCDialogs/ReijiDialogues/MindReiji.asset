  m_Script: {fileID: 11500000, guid: 38ac8ab55697595439f1d4e8f0850b0c, type: 3}
  m_Name: MindReiji
  m_EditorClassIdentifier: 
  dialogues:
  - '"Hey, have you ever noticed that grocery store receipts are incredibly long,
    but microwave popcorn bags always have that one specific warning about not using
    the popcorn button?"

'
  - '"Wait, what? I thought we were talking about quantum mechanics and how particles
    can exist in two places at once."'
  - '"We were. But my brain just drifted to crows. Apparently, they can remember
    human faces and even hold grudges. Imagine cutting off a crow in traffic and
    it tracks you down."'
  - '"That sounds terrifying. Speaking of traffic, why do we drive on parkways but
    park on driveways? Who came up with that linguistic trap?"'
  - '"Probably the same person who decided that pineapples belong on pizza, which
    is an absolute culinary crime, by the way. Though, scientifically, the enzymes
    in pineapple actually digest you back while you eat them."'
  imageNext:
  - {fileID: 0}
